# Injected by Foundry at runtime for hosted agents; set locally for azd ai agent run.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Prefer this name (also what azd typically writes):
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Optional alternate accepted by main.py if the preferred var is unset:
# MICROSOFT_FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
